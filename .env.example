# EcoVista example environment — copy to .env.local and fill real values.

# Supabase (project: vxwujqafskzhmlxvyfuu)
NEXT_PUBLIC_SUPABASE_URL=https://vxwujqafskzhmlxvyfuu.supabase.co
# Get the anon key from Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ<your_anon_key>
# Service role key (server-only secret) — used by /api/sync & /api/weather to write
SUPABASE_SERVICE_ROLE_KEY=eyJ<your_service_role_key>

# AI Engine (NVIDIA NIM, OpenAI-compatible)
AI_API_KEY=nvapi-YOUR_NVIDIA_KEY
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/nemotron-3-super-120b-a12b
